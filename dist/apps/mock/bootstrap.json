{
  "brand": {
    "name": "deepseek",
    "suffix": "HARNESS"
  },
  "hero": {
    "title": "Into the Unknown",
    "badge": "Preview",
    "placeholder": "Describe what you want to build, / commands, @ files or sessions",
    "chatPlaceholder": "Message or run a task, / commands, @ files or sessions"
  },
  "defaults": {
    "workspaceId": "ws-moira",
    "sessionId": "s-cfd",
    "model": "deepseek-v41-flash",
    "effort": "high",
    "mode": "standard",
    "accessMode": "workspace-write"
  },
  "workspaces": [
    {
      "id": "ws-moira",
      "name": "Moira",
      "path": "g:\\Moira",
      "expanded": true,
      "sessions": [
        {
          "id": "s-new",
          "title": "New Session",
          "time": "now",
          "pinned": true
        },
        {
          "id": "s-cfd",
          "title": "CFD流线圈空白问题排查",
          "time": "1d"
        }
      ]
    },
    {
      "id": "ws-lychee",
      "name": "lychee",
      "path": "g:/lychee",
      "expanded": false,
      "sessions": []
    },
    {
      "id": "ws-xdoc",
      "name": "xDoc",
      "path": "g:/xDoc",
      "expanded": false,
      "sessions": []
    },
    {
      "id": "ws-g",
      "name": "G:\\",
      "path": "G:\\",
      "expanded": false,
      "sessions": []
    },
    {
      "id": "ws-default",
      "name": "Default workspace",
      "path": "",
      "expanded": false,
      "sessions": []
    }
  ],
  "models": {
    "groups": [
      {
        "label": "DeepSeek",
        "options": [
          {
            "id": "deepseek-v41-flash",
            "name": "DeepSeek-V41-Flash"
          },
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek-V4-Pro"
          }
        ]
      }
    ]
  },
  "efforts": [
    {
      "id": "off",
      "name": "Off"
    },
    {
      "id": "low",
      "name": "Low"
    },
    {
      "id": "high",
      "name": "High"
    },
    {
      "id": "max",
      "name": "Max"
    }
  ],
  "modes": [
    {
      "id": "standard",
      "name": "Standard mode",
      "desc": "Work with code, files, and information. Suitable for most tasks, with search, editing, terminal commands, and other tools available as needed."
    },
    {
      "id": "ptc",
      "name": "PTC mode",
      "desc": "Includes all Standard mode capabilities. Better suited to tasks that call tools in batches and then filter, organize, deduplicate, count, or summarize the results."
    },
    {
      "id": "minimal",
      "name": "Minimal mode",
      "desc": "The agent works using only a terminal tool. Useful for testing and comparing its basic performance."
    },
    {
      "id": "creator",
      "name": "Creator mode",
      "desc": "Customize DSH through conversation. Let the agent write plugins that add features or UI, or combine tools and prompts to create your own mode."
    }
  ],
  "accessModes": [
    {
      "id": "read-only",
      "name": "Read Only",
      "icon": "shieldRead"
    },
    {
      "id": "workspace-write",
      "name": "Workspace Write",
      "icon": "shieldWrite"
    },
    {
      "id": "full-access",
      "name": "Full access",
      "icon": "shieldFull"
    }
  ],
  "settings": {
    "permission": "workspace-write",
    "language": "English",
    "appearance": "light",
    "fontSize": 14,
    "workDetails": "Detailed",
    "showCodingView": true
  },
  "languages": [
    {
      "id": "en",
      "name": "English"
    },
    {
      "id": "zh",
      "name": "中文"
    }
  ],
  "workDetailsOptions": [
    {
      "id": "concise",
      "name": "Concise"
    },
    {
      "id": "detailed",
      "name": "Detailed"
    }
  ],
  "plugins": [
    {
      "id": "agent-teams",
      "name": "Agent Teams",
      "icon": "pluginAgentTeams",
      "experimental": true,
      "desc": "Enable team collaboration, team tools, the member roster, and the shared task board."
    },
    {
      "id": "auto-authorization-review",
      "name": "Auto Authorization Review",
      "icon": "pluginAutoReview",
      "experimental": true,
      "desc": "Add an Auto review permission mode that uses the model to assess authorization before each tool call."
    },
    {
      "id": "automation-tasks",
      "name": "Automation tasks",
      "icon": "pluginAutomation",
      "experimental": true,
      "desc": "Run tasks in your sessions at a set time or on a repeating schedule."
    },
    {
      "id": "voice-input",
      "name": "Voice input",
      "icon": "pluginVoice",
      "experimental": true,
      "desc": "Transcribe recordings locally with SenseVoice; first use requires installing dependencies."
    },
    {
      "id": "shell",
      "name": "Shell",
      "icon": "pluginShell",
      "experimental": true,
      "desc": "Limit how long each command may run and how much it may output."
    },
    {
      "id": "agent-loop",
      "name": "Agent loop",
      "icon": "pluginAgentLoop",
      "experimental": true,
      "desc": "Control how the Agent dispatches tool calls."
    },
    {
      "id": "subagent",
      "name": "Subagent",
      "icon": "pluginSubagent",
      "experimental": true,
      "desc": "Set Subagent recursion depth, count, and models."
    },
    {
      "id": "web-search",
      "name": "Web search",
      "icon": "pluginWebSearch",
      "experimental": false,
      "desc": "Let the agent search the web for up-to-date information."
    }
  ],
  "quickActions": [
    {
      "id": "workspace-files",
      "title": "Workspace files",
      "desc": "Browse files in this session's workspace",
      "kbd": [
        "Ctrl",
        "Alt",
        "P"
      ],
      "icon": "workspaceFiles"
    },
    {
      "id": "new-terminal",
      "title": "New terminal",
      "desc": "Run commands in the Session workspace",
      "kbd": [
        "Ctrl",
        "`"
      ],
      "icon": "newTerminal"
    }
  ],
  "addMenu": [
    {
      "id": "file",
      "name": "File",
      "icon": "file"
    },
    {
      "id": "goal",
      "name": "Goal",
      "desc": "Set or view the goal for a long-running task",
      "icon": "goal"
    },
    {
      "id": "plan",
      "name": "Plan",
      "desc": "Enter or leave plan mode",
      "icon": "plan"
    },
    {
      "id": "feedback",
      "name": "Feedback",
      "desc": "Record feedback about this session",
      "icon": "feedback"
    }
  ],
  "moreActions": [
    {
      "id": "download-log",
      "name": "Download session log",
      "icon": "filePreview"
    },
    {
      "id": "feedback",
      "name": "Feedback",
      "icon": "feedback"
    }
  ],
  "sessionRowActions": [
    {
      "id": "pin",
      "name": "Pin session",
      "kbd": [],
      "icon": "pin"
    },
    {
      "id": "rename",
      "name": "Rename",
      "kbd": [
        "Ctrl",
        "Alt",
        "G"
      ],
      "icon": "rename"
    },
    {
      "id": "fork",
      "name": "Fork session",
      "kbd": [
        "Ctrl",
        "Shift",
        "F"
      ],
      "icon": "fork"
    },
    {
      "id": "archive",
      "name": "Archive session",
      "kbd": [
        "Ctrl",
        "Alt",
        "A"
      ],
      "icon": "archive"
    }
  ]
}